CANTEEN_PUBLIC_ADDR=127.0.0.1:8080
CANTEEN_INTERNAL_ADDR=127.0.0.1:8081
CANTEEN_DB_PATH=/var/lib/canteen/canteen.db
CANTEEN_TIME_ZONE=Asia/Shanghai
CANTEEN_BACKUP_EXTERNAL_DIR=/mnt/canteen-backup
CANTEEN_SCANNER_DEVICE=/dev/ttyACM0
CANTEEN_SCANNER_MODE=serial
CANTEEN_SCANNER_BAUD=9600
CANTEEN_SERVER_URL=http://127.0.0.1:8080
CANTEEN_TERMINAL_KEY=replace-with-key-from-admin
# Legacy alternatives (used only when the corresponding new variable is unset):
# CANTEEN_TERMINAL_CREDENTIAL_FILE=/etc/canteen/terminal.credential
# CANTEEN_INTERNAL_URL=http://127.0.0.1:8081
# CANTEEN_PUBLIC_URL=http://127.0.0.1:8080
CANTEEN_DISPLAY_ADDR=127.0.0.1:8090
# Optional: absolute path to a speech program that accepts one text argument.
# CANTEEN_TTS_COMMAND=/usr/bin/espeak-ng
