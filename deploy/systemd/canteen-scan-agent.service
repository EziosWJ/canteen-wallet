[Unit]
Description=Canteen Wallet Scan Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canteen
Group=canteen
SupplementaryGroups=dialout
EnvironmentFile=/etc/canteen/canteen.env
ExecStart=/opt/canteen/canteen-scan-agent
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
