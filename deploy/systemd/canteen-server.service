[Unit]
Description=Canteen Wallet Go Server
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=canteen
Group=canteen
WorkingDirectory=/opt/canteen-wallet
EnvironmentFile=/opt/canteen-wallet/canteen.env
ExecStart=/opt/canteen-wallet/canteen-server
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/canteen-wallet/data /opt/canteen-wallet/backups
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
